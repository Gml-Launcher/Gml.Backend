{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build Backend",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Gml.Web.Api/src/Gml.Web.Api/Gml.Web.Api.csproj",
        "--configuration", "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build Skins",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Gml.Web.Skin.Service/src/Gml.Web.Skin.Service/Gml.Web.Skin.Service.csproj",
        "--configuration", "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
